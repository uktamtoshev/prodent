# ===========================================
# PRODENT Backend - Environment Variables
# ===========================================
# Copy this file to .env for local development.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prodent
DB_USERNAME=prodent
DB_PASSWORD=prodent_secret
DB_POOL_SIZE=10

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-me
JWT_EXPIRATION_MS=86400000

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=DEBUG

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB

# --- SMS (Eskiz.uz) ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# --- Email (optional) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
