# ===========================================
# PRODENT - Environment Variables
# ===========================================
# Copy this file to .env and fill in values.

# --- PostgreSQL ---
POSTGRES_DB=prodent
POSTGRES_USER=prodent
POSTGRES_PASSWORD=prodent_secret

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Backend ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=prodent
DB_USERNAME=prodent
DB_PASSWORD=prodent_secret
DB_POOL_SIZE=20
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend (build-time) ---
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws
